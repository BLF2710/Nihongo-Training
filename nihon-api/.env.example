# Copy to .env and fill in. Never commit .env.

# Server
PORT=5000
# NODE_ENV=production   # production also requires CORS_ORIGINS and SMTP_URL
# Web app address(es) allowed to call the API from a browser, comma-separated (defaults to local Vite addresses in development)
# CORS_ORIGINS=https://lingohub.example.com
# Web app address used in links sent by email
APP_URL=http://localhost:5173
# Number of proxies in front of the API (load balancer, Nginx); 0 when none
TRUST_PROXY=0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=nihonweb

# Sign-in tokens: a long random value, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Email (password reset and email confirmation). Without SMTP_URL, emails are printed to the server console (development only).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=LingoHub <no-reply@example.com>

# Where rate limits, sign-in nonces and live-update delivery live: memory (one API process, the development
# default) or postgres (several processes; the production default).
# SHARED_STATE=memory

# Sign in with Google (optional): OAuth client id from Google Cloud Console (see README)
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Study assistant and speaking test grading (optional)
# ANTHROPIC_API_KEY=
# SPEAKING_GRADER_MODEL=claude-haiku-5-5
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com/stt/speech/recognition/conversation/cognitiveservices/v1
